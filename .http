# You will need to add http-client.private.env.json into the main dir

### main_page

# @kulala-curl--http3
# @accept chunked

GET https://open.accelerate.science HTTP/2
Accept: text/html


### proxy

# @accept chunked

< {%
	// Pre-request script
	const crypto = require('crypto');
	const nonce = crypto.randomBytes(16).toString('hex');

	// Set request-scoped variables
	request.variables.set('NONCE', nonce);
%}

# @no-cookie-jar

POST https://open.accelerate.science/proxy/post HTTP/2
Content-Type: application/json
Accept: application/json
Inference-Service: postman
Authorization: Bearer {{TOKEN}}

{
  "hello": "{{$uuid}}",
  "previous": "{{main_page.response.body.*}}",
  "world": "{{NONCE}}"
}

### OLLAMA

POST https://open.accelerate.science/mcp/ollama/api/generate HTTP/2
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{TOKEN}}

{
  "model": "qwen3:32b",
  "prompt": "Why is the sky blue?",
  "stream": false
}

### OLLAMA_List

GET https://open.accelerate.science/mcp/ollama/api/tags HTTP/2
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{TOKEN}}

### OLLAMA_install

POST https://open.accelerate.science/mcp/ollama/api/pull HTTP/2
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{TOKEN}}

{
  "name": "sorc/qwen3.5-claude-4.6-opus"
}

### OLLAMA_delete

DELETE https://open.accelerate.science/mcp/ollama/api/delete HTTP/2
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{TOKEN}}

{
  "name": "sorc/qwen3.5-claude-4.6-opus"
}

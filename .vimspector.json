{
	"configurations": {
		"launch": {
			"adapter": "CodeLLDB",
			"configuration": {
				"request": "launch",
				"program": "${workspaceFolder}/target/debug/${projectFolderBasename}"
			}
		},
		"attach": {
			"adapter": "CodeLLDB",
			"filetypes": [ "rust", "c", "cpp", "jai" ],
			"configuration": {
				"request": "attach",
				"program": "${workspaceRoot}/${fileBasenameNoExtension}",
				"PID": "${PID}",
				"sourceLanguages": [ "rust" ]
			}
		}
	}
}
